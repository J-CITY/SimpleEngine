# Optional SDKs. Nothing is downloaded by CMake; setup is explicit and reproducible.
option(USE_DLSS "Enable NVIDIA DLSS Super Resolution (Windows Vulkan/DX12)" OFF)
option(USE_FSR "Enable AMD FSR Upscaling (Windows Vulkan/DX12)" OFF)
option(USE_FSR_FRAME_GENERATION "Enable AMD FSR Frame Generation (Windows Vulkan/DX12)" OFF)
option(USE_DLSS_FRAME_GENERATION "Enable NVIDIA DLSS Frame Generation (Windows Vulkan/DX12)" OFF)
option(USE_STREAMLINE "Use Streamline for NVIDIA SR/FG and Reflex" ${USE_DLSS_FRAME_GENERATION})
if(USE_DLSS_FRAME_GENERATION AND NOT USE_STREAMLINE)
    message(FATAL_ERROR "DLSS Frame Generation requires USE_STREAMLINE")
endif()
set(IKIGAI_DLSS_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../3rd/DLSS" CACHE PATH "NVIDIA DLSS SDK checkout")
set(IKIGAI_FSR_VULKAN_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../3rd/FidelityFX-Vulkan" CACHE PATH "FidelityFX SDK with Vulkan support")
set(IKIGAI_FSR_DX12_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../3rd/FSR-DX12" CACHE PATH "AMD FSR SDK for DX12")
set(IKIGAI_DLSS_PROJECT_ID "428925a8-5957-4fa0-95a9-d70d699d7038" CACHE STRING "NGX project GUID; use your game's own GUID for distribution")
if((USE_DLSS OR USE_FSR OR USE_FSR_FRAME_GENERATION OR USE_STREAMLINE) AND (NOT WIN32 OR (NOT USE_VULKAN AND NOT USE_DX12)))
    message(FATAL_ERROR "DLSS/FSR integration currently requires Windows and Vulkan or DX12")
endif()
function(ikigai_copy_upscaler_runtime target path)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing SDK runtime: ${path}. Prepare repository submodules; run utils/setup_env.py with the selected SR/FG flags for non-Git runtimes")
    endif()
    add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${path}" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
endfunction()
if(USE_DLSS)
    set(dlss_root "${IKIGAI_DLSS_SDK_ROOT}")
    if(NOT EXISTS "${dlss_root}/include/nvsdk_ngx.h")
        message(FATAL_ERROR "DLSS SDK not found. Prepare repository submodules with git submodule update --init")
    endif()
    target_include_directories(${APP_NAME} PRIVATE "${dlss_root}/include")
    target_compile_definitions(${APP_NAME} PRIVATE IKIGAI_USE_DLSS IKIGAI_DLSS_PROJECT_ID="${IKIGAI_DLSS_PROJECT_ID}")
    if(NOT USE_STREAMLINE)
    target_link_libraries(${APP_NAME} PRIVATE
        "$<$<CONFIG:Debug>:${dlss_root}/lib/Windows_x86_64/x64/nvsdk_ngx_d_dbg.lib>"
        "$<$<NOT:$<CONFIG:Debug>>:${dlss_root}/lib/Windows_x86_64/x64/nvsdk_ngx_d.lib>" shlwapi.lib)
    ikigai_copy_upscaler_runtime(${APP_NAME} "${dlss_root}/lib/Windows_x86_64/rel/nvngx_dlss.dll")
    endif()
endif()
if(USE_FSR OR USE_FSR_FRAME_GENERATION)
    set(fsr_vk "${IKIGAI_FSR_VULKAN_SDK_ROOT}")
    set(fsr_dx "${IKIGAI_FSR_DX12_SDK_ROOT}/Kits/FidelityFX")
    if(USE_FSR)
        target_compile_definitions(${APP_NAME} PRIVATE IKIGAI_USE_FSR)
    endif()
    if(USE_FSR_FRAME_GENERATION)
        target_compile_definitions(${APP_NAME} PRIVATE IKIGAI_USE_FSR_FRAME_GENERATION)
    endif()
    if(USE_VULKAN)
        target_include_directories(${APP_NAME} PRIVATE "${fsr_vk}/ffx-api/include")
        set(fsr_vk_patched "${CMAKE_CURRENT_LIST_DIR}/../utils/.pack/fidelityfx-vulkan-patched/source/ffx-api/bin/amd_fidelityfx_vk.dll")
        if(EXISTS "${fsr_vk_patched}")
            set(fsr_vk_default_runtime "${fsr_vk_patched}")
        else()
            set(fsr_vk_default_runtime "${fsr_vk}/PrebuiltSignedDLL/amd_fidelityfx_vk.dll")
            if(USE_FSR_FRAME_GENERATION)
                message(FATAL_ERROR "FSR Vulkan FG requires the patched runtime: run python utils/build/fidelityfx_vulkan.py, then configure again")
            endif()
        endif()
        set(IKIGAI_FSR_VULKAN_RUNTIME "${fsr_vk_default_runtime}" CACHE FILEPATH "FSR Vulkan runtime; patched source build recommended")
        ikigai_copy_upscaler_runtime(${APP_NAME} "${IKIGAI_FSR_VULKAN_RUNTIME}")
    endif()
    if(USE_DX12)
        target_include_directories(${APP_NAME} PRIVATE "${fsr_dx}/api/include" "${fsr_dx}/upscalers/include")
        ikigai_copy_upscaler_runtime(${APP_NAME} "${fsr_dx}/signedbin/amd_fidelityfx_loader_dx12.dll")
        ikigai_copy_upscaler_runtime(${APP_NAME} "${fsr_dx}/signedbin/amd_fidelityfx_upscaler_dx12.dll")
        if(USE_FSR_FRAME_GENERATION)
            target_include_directories(${APP_NAME} PRIVATE "${fsr_dx}/framegeneration/include")
            ikigai_copy_upscaler_runtime(${APP_NAME} "${fsr_dx}/signedbin/amd_fidelityfx_framegeneration_dx12.dll")
        endif()
    endif()
endif()
if(USE_STREAMLINE)
    set(IKIGAI_STREAMLINE_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../3rd/Streamline" CACHE PATH "Streamline headers checkout")
    set(IKIGAI_STREAMLINE_RUNTIME_ROOT "${CMAKE_CURRENT_LIST_DIR}/../utils/.pack/streamline-2.14.1" CACHE PATH "Pinned Streamline runtime bundle")
    target_include_directories(${APP_NAME} PRIVATE "${IKIGAI_STREAMLINE_SDK_ROOT}/include")
    target_compile_definitions(${APP_NAME} PRIVATE IKIGAI_USE_STREAMLINE)
    target_compile_definitions(${APP_NAME} PRIVATE IKIGAI_DLSS_PROJECT_ID="${IKIGAI_DLSS_PROJECT_ID}")
    if(USE_DLSS_FRAME_GENERATION)
        target_compile_definitions(${APP_NAME} PRIVATE IKIGAI_USE_DLSS_FRAME_GENERATION)
    endif()
    foreach(dll sl.interposer sl.common sl.dlss sl.dlss_g sl.reflex sl.pcl nvngx_dlss nvngx_dlssg NvLowLatencyVk)
        ikigai_copy_upscaler_runtime(${APP_NAME} "${IKIGAI_STREAMLINE_RUNTIME_ROOT}/bin/x64/${dll}.dll")
    endforeach()
endif()
