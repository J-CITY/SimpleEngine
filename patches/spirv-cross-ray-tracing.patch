diff --git a/spirv_hlsl_raytracing.cpp b/spirv_hlsl_raytracing.cpp
new file mode 100644
index 00000000..06908c0a
--- /dev/null
+++ b/spirv_hlsl_raytracing.cpp
@@ -0,0 +1,188 @@
+/* SPDX-License-Identifier: Apache-2.0 OR MIT
+ * HLSL lowering for SPV_KHR_ray_tracing. Kept separate from raster lowering.
+ */
+#include "spirv_hlsl.hpp"
+
+using namespace SPIRV_CROSS_NAMESPACE;
+using namespace SPIRV_CROSS_SPV_HEADER_NAMESPACE;
+using namespace std;
+
+bool CompilerHLSL::is_ray_tracing_shader() const
+{
+	switch (get_execution_model())
+	{
+	case ExecutionModelRayGenerationKHR:
+	case ExecutionModelMissKHR:
+	case ExecutionModelClosestHitKHR:
+	case ExecutionModelAnyHitKHR:
+	case ExecutionModelIntersectionKHR:
+	case ExecutionModelCallableKHR: return true;
+	default: return false;
+	}
+}
+
+bool CompilerHLSL::is_ray_tracing_storage(StorageClass storage)
+{
+	switch (storage)
+	{
+	case StorageClassRayPayloadKHR:
+	case StorageClassIncomingRayPayloadKHR:
+	case StorageClassCallableDataKHR:
+	case StorageClassIncomingCallableDataKHR:
+	case StorageClassHitAttributeKHR:
+	case StorageClassShaderRecordBufferKHR: return true;
+	default: return false;
+	}
+}
+
+string CompilerHLSL::ray_tracing_wrapper_name(uint32_t id) const
+{
+	return join("SPIRV_Cross_RayData_", id);
+}
+
+void CompilerHLSL::emit_ray_tracing_resources()
+{
+	incoming_ray_payload = incoming_callable_data = ray_hit_attribute = 0;
+	if (get_execution_model() == ExecutionModelAnyHitKHR)
+		statement("static uint spvRayTermination = 0u;");
+	ir.for_each_typed_id<SPIRVariable>([&](uint32_t, SPIRVariable &var) {
+		if (!is_ray_tracing_storage(var.storage) || is_hidden_variable(var))
+			return;
+		if (var.storage == StorageClassShaderRecordBufferKHR)
+		{
+			emit_buffer_block(var);
+			return;
+		}
+		add_resource_name(var.self);
+		statement("static ", variable_decl(var), ";");
+		// DXR requires struct payload/attribute parameters, even for scalar GLSL data.
+		statement("struct ", ray_tracing_wrapper_name(var.self));
+		begin_scope();
+		const auto &type = get_variable_data_type(var);
+		statement(type_to_glsl(type), " value", type_to_array_glsl(type, var.self), ";");
+		end_scope_decl();
+		uint32_t *incoming = nullptr;
+		if (var.storage == StorageClassIncomingRayPayloadKHR) incoming = &incoming_ray_payload;
+		if (var.storage == StorageClassIncomingCallableDataKHR) incoming = &incoming_callable_data;
+		if (var.storage == StorageClassHitAttributeKHR) incoming = &ray_hit_attribute;
+		if (incoming)
+		{
+			if (*incoming) SPIRV_CROSS_THROW("DXR stages accept one incoming payload/callable datum/hit attribute.");
+			*incoming = var.self;
+		}
+	});
+	statement("struct SPIRV_Cross_UnusedRayData { uint value; };");
+	statement("struct SPIRV_Cross_UnusedHitAttribute { float2 value; };");
+	statement("");
+}
+
+void CompilerHLSL::emit_ray_tracing_entry_point()
+{
+	const char *stage = nullptr;
+	uint32_t payload = 0;
+	bool has_payload = false, has_attribute = false;
+	switch (get_execution_model())
+	{
+	case ExecutionModelRayGenerationKHR: stage = "raygeneration"; break;
+	case ExecutionModelMissKHR: stage = "miss"; has_payload = true; payload = incoming_ray_payload; break;
+	case ExecutionModelClosestHitKHR: stage = "closesthit"; has_payload = has_attribute = true; payload = incoming_ray_payload; break;
+	case ExecutionModelAnyHitKHR: stage = "anyhit"; has_payload = has_attribute = true; payload = incoming_ray_payload; break;
+	case ExecutionModelIntersectionKHR: stage = "intersection"; break;
+	case ExecutionModelCallableKHR: stage = "callable"; has_payload = true; payload = incoming_callable_data; break;
+	default: SPIRV_CROSS_THROW("Invalid DXR stage.");
+	}
+	SmallVector<string> arguments;
+	if (has_payload)
+		arguments.push_back(join("inout ", payload ? ray_tracing_wrapper_name(payload) : "SPIRV_Cross_UnusedRayData", " spvPayload"));
+	if (has_attribute)
+		arguments.push_back(join(ray_hit_attribute ? ray_tracing_wrapper_name(ray_hit_attribute) : "SPIRV_Cross_UnusedHitAttribute", " spvAttributes"));
+	statement("[shader(\"", stage, "\")]");
+	statement("void main(", merge(arguments), ")");
+	begin_scope();
+	if (payload) statement(to_name(payload), " = spvPayload.value;");
+	if (has_attribute && ray_hit_attribute) statement(to_name(ray_hit_attribute), " = spvAttributes.value;");
+	statement(get_inner_entry_point_name(), "();");
+	if (payload) statement("spvPayload.value = ", to_name(payload), ";");
+	if (get_execution_model() == ExecutionModelAnyHitKHR)
+	{
+		statement("if (spvRayTermination == 1u) IgnoreHit();");
+		statement("if (spvRayTermination == 2u) AcceptHitAndEndSearch();");
+	}
+	end_scope();
+}
+
+bool CompilerHLSL::emit_ray_tracing_instruction(const Instruction &instruction)
+{
+	const auto *ops = stream(instruction);
+	switch (static_cast<Op>(instruction.op))
+	{
+	case OpFunctionCall:
+		if (get_execution_model() != ExecutionModelAnyHitKHR) return false;
+		// Evaluate before checking the flag, then unwind every helper to the entry
+		// point, where incoming payload writes are committed before terminating.
+		forced_temporaries.insert(ops[1]);
+		CompilerGLSL::emit_instruction(instruction);
+		statement("if (spvRayTermination != 0u)");
+		begin_scope(); emit_ray_tracing_return(); end_scope();
+		return true;
+	case OpTraceRayKHR:
+	{
+		const auto &var = get<SPIRVariable>(ops[10]);
+		if (var.storage != StorageClassRayPayloadKHR && var.storage != StorageClassIncomingRayPayloadKHR)
+			SPIRV_CROSS_THROW("TraceRayKHR requires a ray payload variable.");
+		const auto suffix = join(current_emitting_block->self, "_", unique_identifier_count++);
+		const auto ray = join("spvRay_", suffix), payload = join("spvPayload_", suffix);
+		statement("RayDesc ", ray, ";");
+		statement(ray, ".Origin = ", to_expression(ops[6]), ";");
+		statement(ray, ".TMin = ", to_expression(ops[7]), ";");
+		statement(ray, ".Direction = ", to_expression(ops[8]), ";");
+		statement(ray, ".TMax = ", to_expression(ops[9]), ";");
+		statement(ray_tracing_wrapper_name(var.self), " ", payload, ";");
+		statement(payload, ".value = ", to_expression(var.self), ";");
+		statement("TraceRay(", to_non_uniform_aware_expression(ops[0]), ", ", to_expression(ops[1]), ", ", to_expression(ops[2]), ", ",
+		          to_expression(ops[3]), ", ", to_expression(ops[4]), ", ", to_expression(ops[5]), ", ", ray, ", ", payload, ");");
+		statement(to_expression(var.self), " = ", payload, ".value;");
+		flush_control_dependent_expressions(current_emitting_block->self);
+		return true;
+	}
+	case OpExecuteCallableKHR:
+	{
+		const auto &var = get<SPIRVariable>(ops[1]);
+		if (var.storage != StorageClassCallableDataKHR && var.storage != StorageClassIncomingCallableDataKHR)
+			SPIRV_CROSS_THROW("ExecuteCallableKHR requires a callable-data variable.");
+		const auto payload = join("spvCallable_", unique_identifier_count++);
+		statement(ray_tracing_wrapper_name(var.self), " ", payload, ";");
+		statement(payload, ".value = ", to_expression(var.self), ";");
+		statement("CallShader(", to_expression(ops[0]), ", ", payload, ");");
+		statement(to_expression(var.self), " = ", payload, ".value;");
+		flush_control_dependent_expressions(current_emitting_block->self);
+		return true;
+	}
+	case OpReportIntersectionKHR:
+	{
+		const auto attribute = join("spvHitAttribute_", unique_identifier_count++);
+		statement(ray_hit_attribute ? ray_tracing_wrapper_name(ray_hit_attribute) : "SPIRV_Cross_UnusedHitAttribute", " ", attribute, ";");
+		statement(attribute, ".value = ", ray_hit_attribute ? to_expression(ray_hit_attribute) : "float2(0.0f, 0.0f)", ";");
+		forced_temporaries.insert(ops[1]);
+		emit_op(ops[0], ops[1], join("ReportHit(", to_expression(ops[2]), ", ", to_expression(ops[3]), ", ", attribute, ")"), false);
+		flush_control_dependent_expressions(current_emitting_block->self);
+		return true;
+	}
+	default: return false;
+	}
+}
+
+void CompilerHLSL::emit_ray_tracing_return()
+{
+	const auto &type = get<SPIRType>(current_function->return_type);
+	if (type.basetype == SPIRType::Void || !type.array.empty()) statement("return;");
+	else statement("return ", to_zero_initialized_expression(type.self), ";");
+}
+
+void CompilerHLSL::emit_ray_tracing_terminator(const SPIRBlock &block)
+{
+	if (get_execution_model() != ExecutionModelAnyHitKHR)
+		SPIRV_CROSS_THROW("IgnoreIntersectionKHR/TerminateRayKHR require an any-hit shader.");
+	statement("spvRayTermination = ", block.terminator == SPIRBlock::IgnoreIntersection ? "1u;" : "2u;");
+	emit_ray_tracing_return();
+}
